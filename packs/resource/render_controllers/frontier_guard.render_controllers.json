        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.headbands[query.property('jagsby_frontier:headband')]"
      ],
      "arrays": {
        "textures": {
          "Array.headbands": [
            "Texture.default",
            "Texture.band1",
            "Texture.band2",
            "Texture.band3",
            "Texture.band4",
            "Texture.band5",
            "Texture.band6",
            "Texture.band7",
            "Texture.band8"
          ]
        }
      },
      "part_visibility": [
        {
          "leaderPlume": "query.property('jagsby_frontier:squad_leader')"
        }
      ]
    },
    "controller.render.jagsby_frontier.guard_horse": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "Bag*": false
        },
        {
          "MuleEar*": false
        }
      ]
    }
