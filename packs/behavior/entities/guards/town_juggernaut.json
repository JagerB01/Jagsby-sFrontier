{
  "format_version": "1.26.0",
  "minecraft:entity": {
    "description": {
      "identifier": "jagsby_frontier:town_juggernaut",
      "is_spawnable": false,
      "is_summonable": true,
      "properties": {
        "jagsby_frontier:shield_stance": {
          "type": "enum",
          "values": [
            "ready",
            "raised",
            "recovering"
          ],
          "default": "ready",
          "client_sync": true
        },
        "jagsby_frontier:squad_leader": {
          "type": "bool",
          "default": false,
          "client_sync": true
        },
        "jagsby_frontier:headband": {
          "type": "int",
          "range": [
            0,
            8
          ],
          "default": 0,
          "client_sync": true
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "mob",
          "frontier_guard",
          "frontier_town_guard"
        ]
      },
      "minecraft:health": {
        "value": 38,
        "max": 38
      },
      "minecraft:movement": {
        "value": 0.29
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:navigation.walk": {
        "avoid_water": true,
        "avoid_damage_blocks": true
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.95
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:nameable": {},
      "minecraft:persistent": {},
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.random_stroll": {
        "priority": 10,
        "speed_multiplier": 0.7,
        "xz_dist": 10,
        "y_dist": 3
      },
      "minecraft:behavior.look_at_player": {
        "priority": 11,
        "look_distance": 8
      },
      "minecraft:behavior.random_look_around": {
        "priority": 12
      },
      "minecraft:follow_range": {
        "value": 28
      },
      "minecraft:equipment": {
        "table": "loot_tables/guards/juggernaut.json",
        "slot_drop_chance": [
          {
            "slot": "slot.weapon.mainhand",
            "drop_chance": 0
          },
          {
            "slot": "slot.weapon.offhand",
            "drop_chance": 0
          }
        ]
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "must_see": true,
        "must_see_forget_duration": 3,
        "reselect_targets": true,
        "entity_types": [
          {
            "max_dist": 13,
            "filters": {
              "all_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "monster"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "creeper",
                  "operator": "!="
                }
              ]
            }
          }
        ]
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "entity_attack",
            "deals_damage": "no",
            "on_damage": {
              "filters": {
                "any_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "frontier_guard"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "frontier_guard_mount"
                  }
                ]
              }
            }
          },
          {
            "cause": "projectile",
            "deals_damage": "no",
            "on_damage": {
              "filters": {
                "any_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "frontier_guard"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "frontier_guard_mount"
                  }
                ]
              }
            }
          }
        ]
      },
      "minecraft:attack": {
        "damage": 6
      },
      "minecraft:behavior.melee_box_attack": {
        "priority": 3,
        "track_target": true,
        "speed_multiplier": 1.05
      },
      "minecraft:knockback_resistance": {
        "value": 0.25
      },
      "minecraft:environment_sensor": {
        "triggers": [
          {
            "filters": {
              "all_of": [
                {
                  "test": "enum_property",
                  "subject": "self",
                  "value": "ready",
                  "domain": "jagsby_frontier:shield_stance"
                },
                {
                  "test": "has_target",
                  "subject": "self",
                  "value": true
                },
                {
                  "test": "target_distance",
                  "subject": "self",
                  "value": 3,
                  "operator": ">="
                },
                {
                  "test": "target_distance",
                  "subject": "self",
                  "value": 12,
                  "operator": "<="
                }
              ]
            },
            "event": "jagsby_frontier:shield_raise"
          },
          {
            "filters": {
              "all_of": [
                {
                  "test": "enum_property",
                  "subject": "self",
                  "value": "raised",
                  "domain": "jagsby_frontier:shield_stance"
                },
                {
                  "any_of": [
                    {
                      "test": "has_target",
                      "subject": "self",
                      "value": false
                    },
                    {
                      "test": "target_distance",
                      "subject": "self",
                      "value": 2,
                      "operator": "<="
                    }
                  ]
                }
              ]
            },
            "event": "jagsby_frontier:shield_lower"
          }
        ]
      },
      "minecraft:home": {
        "restriction_radius": 48,
        "restriction_type": "all_movement"
      },
      "minecraft:dweller": {
        "dwelling_type": "village",
        "dweller_role": "defender",
        "can_find_poi": false,
        "can_migrate": false,
        "update_interval_base": 60,
        "update_interval_variant": 40
      },
      "minecraft:preferred_path": {
        "default_block_cost": 1.5,
        "jump_cost": 3,
        "max_fall_blocks": 1,
        "preferred_path_blocks": [
          {
            "blocks": [
              "grass_path",
              "cobblestone",
              "gravel"
            ],
            "cost": 1
          }
        ]
      },
      "minecraft:behavior.move_towards_home_restriction": {
        "priority": 6,
        "speed_multiplier": 0.8
      },
      "minecraft:behavior.move_towards_dwelling_restriction": {
        "priority": 7,
        "speed_multiplier": 0.8
      },
      "minecraft:behavior.move_to_block": {
        "priority": 8,
        "speed_multiplier": 0.7,
        "search_range": 8,
        "search_height": 2,
        "tick_interval": 100,
        "start_chance": 0.22,
        "goal_radius": 1.25,
        "target_blocks": [
          "minecraft:grass_path",
          "minecraft:cobblestone",
          "minecraft:gravel"
        ],
        "target_selection_method": "random",
        "target_offset": [
          0,
          1,
          0
        ]
      },
      "minecraft:behavior.move_through_village": {
        "priority": 9,
        "speed_multiplier": 0.7,
        "only_at_night": false
      }
    },
    "component_groups": {
      "jagsby_frontier:shield_raised": {
        "minecraft:timer": {
          "looping": false,
          "time": 3,
          "time_down_event": {
            "event": "jagsby_frontier:shield_lower",
            "target": "self"
          }
        }
      },
      "jagsby_frontier:shield_recovering": {
        "minecraft:timer": {
          "looping": false,
          "time": 2,
          "time_down_event": {
            "event": "jagsby_frontier:shield_reset",
            "target": "self"
          }
        }
      }
    },
    "events": {
      "jagsby_frontier:shield_raise": {
        "add": {
          "component_groups": [
            "jagsby_frontier:shield_raised"
          ]
        },
        "set_property": {
          "jagsby_frontier:shield_stance": "raised"
        }
      },
      "jagsby_frontier:shield_lower": {
        "remove": {
          "component_groups": [
            "jagsby_frontier:shield_raised"
          ]
        },
        "add": {
          "component_groups": [
            "jagsby_frontier:shield_recovering"
          ]
        },
        "set_property": {
          "jagsby_frontier:shield_stance": "recovering"
        }
      },
      "jagsby_frontier:shield_reset": {
        "remove": {
          "component_groups": [
            "jagsby_frontier:shield_recovering"
          ]
        },
        "set_property": {
          "jagsby_frontier:shield_stance": "ready"
        }
      }
    }
  }
}
